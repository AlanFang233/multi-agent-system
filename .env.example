# Set your own key in .env; never commit it.
OPENAI_API_KEY=
# Set to a model available to your OpenAI API account.
OPENAI_MODEL=gpt-5-mini

# Local development only. Replace when sharing the environment.
POSTGRES_USER=agent
POSTGRES_PASSWORD=local_dev_change_me
POSTGRES_DB=multi_agent
DATABASE_URL=postgresql+asyncpg://agent:local_dev_change_me@127.0.0.1:5432/multi_agent
REDIS_URL=redis://127.0.0.1:6379/0

# A2A card addresses must be reachable from callers.
RESEARCH_AGENT_URL=http://127.0.0.1:8001
CODING_AGENT_URL=http://127.0.0.1:8002
ANALYSIS_AGENT_URL=http://127.0.0.1:8003
